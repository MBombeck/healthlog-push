# Managed by Ansible (role healthlog_push). Do not edit on the host.
HLP_IMAGE={{ healthlog_push_env_image }}
HLP_IMAGE_DIGEST={{ healthlog_push_env_image.split('@')[1] }}
HLP_ROOT={{ healthlog_push_root }}
HLP_SECRETS_REV={{ healthlog_push_secrets_rev }}
HLP_PUBLIC_HOST={{ healthlog_push_public_host }}
HLP_LISTEN={{ healthlog_push_listen }}
HLP_TLS_MODE={{ healthlog_push_tls_mode }}
HLP_ACME_DIRECTORY={{ healthlog_push_acme_directory }}
HLP_ACME_EMAIL={{ healthlog_push_acme_email }}
HLP_APNS_TOPIC={{ healthlog_push_apns_topic }}
HLP_APNS_KEY_ID={{ healthlog_push_apns_key_id }}
HLP_APNS_TEAM_ID={{ healthlog_push_apns_team_id }}
HLP_MIN_CLIENT_VERSION={{ healthlog_push_min_client_version }}
HLP_REGISTRATION_MODE={{ healthlog_push_registration_mode }}
HLP_PUBLIC_STATS={{ healthlog_push_public_stats | bool | lower }}
HLP_APPARMOR_RELAY={{ healthlog_push_apparmor_relay }}
HLP_APPARMOR_SIGNER={{ healthlog_push_apparmor_signer }}
{% if healthlog_push_log_driver == 'journald' %}
# Container logs go to the systemd journal (compose.journald.yaml).
COMPOSE_FILE={{ healthlog_push_root }}/compose/compose.yaml:{{ healthlog_push_root }}/compose/compose.journald.yaml
{% endif %}
